# Copy to .env.local and fill in. See README.md for where each value comes from.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
CRON_SECRET=

# Signs platform admin (superadmin) sessions and encrypts their authenticator
# secrets. Long random string, different from SUPABASE_JWT_SECRET. Changing it
# ends every superadmin session and requires an MFA reset.
SUPERADMIN_JWT_SECRET=

# Platform brand shown on the login screen and browser tab before a club is
# selected. Defaults to "Ruzz" if unset. Each club's own name/logo/color is
# stored per-tenant in the `tenants` table and configured from Admin ->
# Pengaturan after logging in, not via env vars.
NEXT_PUBLIC_APP_NAME=

# Public site URL used for canonical links, Open Graph, sitemap and robots.
# Falls back to the Vercel production URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Contact shown in the landing footer and FAQ. Leave empty to hide the
# contact elements entirely. WhatsApp: international number, digits only
# (for example 628123456789).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=

# Club registration email verification (Resend). When either is empty the
# server logs a warning at startup and registration signs the owner in
# immediately without verification.
EMAIL_API_KEY=
EMAIL_FROM=

# Cloudflare Turnstile captcha on club registration. When either is empty the
# captcha step is skipped (warning at startup).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
